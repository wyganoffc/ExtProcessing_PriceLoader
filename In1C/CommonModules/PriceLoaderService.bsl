#Область ПрограммныйИнтерфейс

Функция ПрочитатьExcel(ТабличныйДокумент) Экспорт
    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("Артикул");
    Результат.Колонки.Добавить("Наименование");
    Результат.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
    Результат.Колонки.Добавить("Валюта");
    Для НомерСтроки = 2 По ТабличныйДокумент.ВысотаТаблицы Цикл
        Артикул = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 1).Текст);
        Если ПустаяСтрока(Артикул) Тогда
            Продолжить;
        КонецЕсли;
        НоваяСтрока = Результат.Добавить();
        НоваяСтрока.Артикул        = Артикул;
        НоваяСтрока.Наименование   = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 2).Текст);
        НоваяСтрока.Цена           = Число(ТабличныйДокумент.Область(НомерСтроки, 3).Текст);
        НоваяСтрока.Валюта         = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 4).Текст);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция НайтиНоменклатуру(МассивАртикулов) Экспорт
    Результат = Новый Соответствие;
    Если МассивАртикулов.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   Номенклатура.Артикул КАК Артикул,
        |   Номенклатура.Ссылка  КАК Ссылка
        |ИЗ
        |   Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
        |   Номенклатура.Артикул В (&МассивАртикулов)";
    Запрос.УстановитьПараметр("МассивАртикулов", МассивАртикулов);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Результат.Вставить(Выборка.Артикул, Выборка.Ссылка);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ЗаписатьЦены(ТаблицаСЦенами, ТипЦены) Экспорт
    Если ТаблицаСЦенами.Количество() = 0 Тогда
        Возврат "Нет данных для загрузки.";
    КонецЕсли;
    Документ = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
    Документ.Дата  = ТекущаяДата();
    Документ.ТипЦен = ТипЦены;  
    Для Каждого Строка Из ТаблицаСЦенами Цикл
        НоваяСтрокаДок = Документ.Товары.Добавить();
        НоваяСтрокаДок.Номенклатура = Строка.Номенклатура;
        НоваяСтрокаДок.Цена         = Строка.Цена;
        НоваяСтрокаДок.Валюта       = Строка.Валюта;
    КонецЦикла;
    Документ.Записать(РежимЗаписиДокумента.Проведение);
    Возврат СтрШаблон("Загружено позиций: %1. Документ: %2",
        ТаблицаСЦенами.Количество(),
        Документ.Номер);
КонецФункции

#КонецОбласти