<?xml version="1.0" encoding="UTF-8"?>
<MetaDataObject xmlns="http://v8.1c.ru/8.3/MDClasses" xmlns:app="http://v8.1c.ru/8.2/managed-application/core" xmlns:cfg="http://v8.1c.ru/8.1/data/enterprise/current-config" xmlns:cmi="http://v8.1c.ru/8.2/data/conf-metadata-information" xmlns:ent="http://v8.1c.ru/8.1/data/enterprise" xmlns:lf="http://v8.1c.ru/8.2/uobjects/lf" xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows" xmlns:xen="http://v8.1c.ru/8.3/xcf/enums" xmlns:xpr="http://v8.1c.ru/8.3/xcf/predefined" xmlns:xr="http://v8.1c.ru/8.3/xcf/readable" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.4">
    
    <!-- Основные реквизиты обработки: путь к файлу и тип цены -->
    <ExternalDataProcessor>
        <Name>ExtProcessing_PriceLoader</Name>
        <Synonym>
            <v8:item>
                <v8:lang>ru</v8:lang>
                <v8:content>Загрузка прайса из Excel</v8:content>
            </v8:item>
        </Synonym>
        <Comment/>
        <Attributes>
            <Attribute>
                <Name>ПутьКФайлу</Name>
                <Synonym>
                    <v8:item>
                        <v8:lang>ru</v8:lang>
                        <v8:content>Путь к файлу</v8:content>
                    </v8:item>
                </Synonym>
                <Type>
                    <v8:Type>xs:string</v8:Type>
                    <v8:StringQualifiers>
                        <v8:Length>0</v8:Length>
                        <v8:AllowedLength>Variable</v8:AllowedLength>
                    </v8:StringQualifiers>
                </Type>
            </Attribute>
            <Attribute>
                <Name>ТипЦены</Name>
                <Synonym>
                    <v8:item>
                        <v8:lang>ru</v8:lang>
                        <v8:content>Тип цены</v8:content>
                    </v8:item>
                </Synonym>
                <Type>
                    <v8:Type>cfg:CatalogRef.ТипыЦенНоменклатуры</v8:Type>
                </Type>
            </Attribute>
            <Attribute>
                <Name>СообщениеРезультата</Name>
                <Synonym>
                    <v8:item>
                        <v8:lang>ru</v8:lang>
                        <v8:content>Результат загрузки</v8:content>
                    </v8:item>
                </Synonym>
                <Type>
                    <v8:Type>xs:string</v8:Type>
                    <v8:StringQualifiers>
                        <v8:Length>0</v8:Length>
                        <v8:AllowedLength>Variable</v8:AllowedLength>
                    </v8:StringQualifiers>
                </Type>
            </Attribute>
        </Attributes>
        
        <!-- Макет для шаблона Excel -->
        <Templates>
            <Template>
                <Name>ШаблонПрайса</Name>
                <Synonym>
                    <v8:item>
                        <v8:lang>ru</v8:lang>
                        <v8:content>Шаблон прайс-листа</v8:content>
                    </v8:item>
                </Synonym>
                <Type>SpreadsheetDocument</Type>
            </Template>
        </Templates>
        
        <!-- Формы -->
        <Forms>
            <Form>MainForm</Form>
        </Forms>
    </ExternalDataProcessor>
    
</MetaDataObject>