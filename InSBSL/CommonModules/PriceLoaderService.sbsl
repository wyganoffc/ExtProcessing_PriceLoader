метод ПрочитатьExcel(Данные: Массив<Массив<Строка>>): Массив<Соответствие<Строка, Строка>>
    пер Результат = новый Массив<Соответствие<Строка, Строка>>()
    
    для НомерСтроки = 1 по Данные.Размер() - 1
        пер СтрокаДанных = Данные[НомерСтроки]
        если СтрокаДанных[0] == ""
            продолжить
        ;
        пер НоваяСтрока = новый Соответствие<Строка, Строка>()
        НоваяСтрока.Вставить("Артикул", СтрокаДанных[0])
        НоваяСтрока.Вставить("Наименование", СтрокаДанных[1])
        НоваяСтрока.Вставить("Цена", СтрокаДанных[2])
        НоваяСтрока.Вставить("Валюта", СтрокаДанных[3])
        Результат.Добавить(НоваяСтрока)
    ;
    
    возврат Результат
;

метод Скрипт()
    пер Данные = новый Массив<Массив<Строка>>()
    Данные.Добавить(новый Массив<Строка>())
    Данные[0].Добавить("Артикул")
    Данные[0].Добавить("Наименование")
    Данные[0].Добавить("Цена")
    Данные[0].Добавить("Валюта")
    
    Данные.Добавить(новый Массив<Строка>())
    Данные[1].Добавить("А001")
    Данные[1].Добавить("Товар 1")
    Данные[1].Добавить("100")
    Данные[1].Добавить("RUB")
    
    Данные.Добавить(новый Массив<Строка>())
    Данные[2].Добавить("А002")
    Данные[2].Добавить("Товар 2")
    Данные[2].Добавить("200")
    Данные[2].Добавить("USD")
    
    пер Результат = ПрочитатьExcel(Данные)
    Консоль.Записать("Загружено строк: ${Результат.Размер()}")
;