метод ПрочитатьExcel(Данные: Массив<Массив<Строка>>): Массив<Соответствие<Строка, Строка>>
    пер Результат = новый Массив<Соответствие<Строка, Строка>>()
    
    для НомерСтроки = 1 по Данные.Размер() - 1
        пер СтрокаДанных = Данные[НомерСтроки]
        если СтрокаДанных[0] == ""
            продолжить
        ;
        пер НоваяСтрока = новый Соответствие<Строка, Строка>()
        НоваяСтрока.Вставить("Артикул", СтрокаДанных[0])
        НоваяСтрока.Вставить("Наименование", СтрокаДанных[1])
        НоваяСтрока.Вставить("Цена", СтрокаДанных[2])
        НоваяСтрока.Вставить("Валюта", СтрокаДанных[3])
        Результат.Добавить(НоваяСтрока)
    ;
    
    возврат Результат
;

метод ПоказатьПредпросмотр(Данные: Массив<Соответствие<Строка, Строка>>)
    Консоль.Записать("=== ПРЕДПРОСМОТР ДАННЫХ ===")
    Консоль.Записать("Артикул | Наименование | Цена | Валюта")
    Консоль.Записать("----------------------------------------")
    
    для Индекс = 0 по Данные.Размер() - 1
        пер Строка = Данные[Индекс]
        Консоль.Записать("${Строка["Артикул"]} | ${Строка["Наименование"]} | ${Строка["Цена"]} | ${Строка["Валюта"]}")
    ;
;

метод Загрузить()
    Консоль.Записать("=== ЗАГРУЗКА ПРАЙСА ИЗ EXCEL ===")
    Консоль.Записать("")
    
    // Имитация выбора файла и типа цены
    пер ПутьКФайлу = "C:\\Прайсы\\Прайс_01.01.2026.xlsx"
    пер ТипЦены = "Оптовая"
    
    Консоль.Записать("Путь к файлу: $ПутьКФайлу")
    Консоль.Записать("Тип цены: $ТипЦены")
    Консоль.Записать("")
    
    // Тестовые данные (имитация чтения Excel)
    пер ДанныеExcel = новый Массив<Массив<Строка>>()
    ДанныеExcel.Добавить(новый Массив<Строка>())
    ДанныеExcel[0].Добавить("Артикул")
    ДанныеExcel[0].Добавить("Наименование")
    ДанныеExcel[0].Добавить("Цена")
    ДанныеExcel[0].Добавить("Валюта")
    
    ДанныеExcel.Добавить(новый Массив<Строка>())
    ДанныеExcel[1].Добавить("А001")
    ДанныеExcel[1].Добавить("Монитор 24\"")
    ДанныеExcel[1].Добавить("15000")
    ДанныеExcel[1].Добавить("RUB")
    
    ДанныеExcel.Добавить(новый Массив<Строка>())
    ДанныеExcel[2].Добавить("А002")
    ДанныеExcel[2].Добавить("Клавиатура")
    ДанныеExcel[2].Добавить("3500")
    ДанныеExcel[2].Добавить("RUB")
    
    ДанныеExcel.Добавить(новый Массив<Строка>())
    ДанныеExcel[3].Добавить("")
    ДанныеExcel[3].Добавить("")
    ДанныеExcel[3].Добавить("")
    ДанныеExcel[3].Добавить("")
    
    ДанныеExcel.Добавить(новый Массив<Строка>())
    ДанныеExcel[4].Добавить("А003")
    ДанныеExcel[4].Добавить("Мышь")
    ДанныеExcel[4].Добавить("1200")
    ДанныеExcel[4].Добавить("RUB")
    
    // Загрузка
    пер ТаблицаДанных = ПрочитатьExcel(ДанныеExcel)
    
    // Предпросмотр
    ПоказатьПредпросмотр(ТаблицаДанных)
    
    // Результат
    Консоль.Записать("")
    пер Сообщение = "Загружено позиций: ${ТаблицаДанных.Размер()}. Документ: УЦ-000001"
    Консоль.Записать("=== $Сообщение ===")
;

метод СкачатьШаблон()
    Консоль.Записать("=== СКАЧИВАНИЕ ШАБЛОНА ===")
    Консоль.Записать("Шаблон прайс-листа:")
    Консоль.Записать("Колонки: Артикул | Наименование | Цена | Валюта")
    Консоль.Записать("Формат: Excel (.xlsx)")
    Консоль.Записать("")
    Консоль.Записать("Пример заполнения:")
    Консоль.Записать("А001 | Товар 1 | 1000 | RUB")
    Консоль.Записать("А002 | Товар 2 | 2000 | USD")
;

метод Скрипт()
    Консоль.Записать("ДОСТУПНЫЕ КОМАНДЫ:")
    Консоль.Записать("1. Загрузить() — загрузка прайса")
    Консоль.Записать("2. СкачатьШаблон() — скачать шаблон")
    Консоль.Записать("")
    
    // Демонстрация загрузки
    Загрузить()
    
    Консоль.Записать("")
    
    // Демонстрация скачивания шаблона
    СкачатьШаблон()
;