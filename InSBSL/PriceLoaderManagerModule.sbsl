метод ПрочитатьExcelИзМассива(): Массив<Массив<Строка>>
    пер Данные = новый Массив<Массив<Строка>>()
    
    пер Стр1 = новый Массив<Строка>()
    Стр1.Добавить("А001")
    Стр1.Добавить("Монитор 24\"")
    Стр1.Добавить("15000")
    Стр1.Добавить("RUB")
    Данные.Добавить(Стр1)
    
    пер Стр2 = новый Массив<Строка>()
    Стр2.Добавить("А002")
    Стр2.Добавить("Клавиатура")
    Стр2.Добавить("3500")
    Стр2.Добавить("RUB")
    Данные.Добавить(Стр2)
    
    пер Стр3 = новый Массив<Строка>()
    Стр3.Добавить("А999")
    Стр3.Добавить("Неизвестный товар")
    Стр3.Добавить("999")
    Стр3.Добавить("USD")
    Данные.Добавить(Стр3)
    
    возврат Данные
;

метод НайтиНоменклатуруПоАртикулам(Артикулы: Массив<Строка>): Массив<Строка>
    пер РезПоиск = новый Массив<Строка>()
    
    для Ид = 0 по Артикулы.Размер() - 1
        пер Арт = Артикулы[Ид]
        если Арт == "А001"
            РезПоиск.Добавить("Монитор 24\"")
        иначе если Арт == "А002"
            РезПоиск.Добавить("Клавиатура")
        иначе
            РезПоиск.Добавить("")
        ;
    ;
    
    возврат РезПоиск
;

метод ЗаписатьЦены(Таблица: Массив<Массив<Строка>>, ТипЦены: Строка): Строка
    пер Кол = Таблица.Размер()
    возврат "Загружено позиций: $Кол. Документ: УЦ-000001 (тип цены: $ТипЦены)"
;

метод ЗагрузитьПрайс(ПутьКФайлу: Строка, ТипЦены: Строка): Массив<Строка>
    пер РезЗагрузки = новый Массив<Строка>()
    РезЗагрузки.Добавить("Ложь")
    РезЗагрузки.Добавить("0")
    РезЗагрузки.Добавить("")
    
    пер ДанныеExcel = ПрочитатьExcelИзМассива()
    
    если ДанныеExcel.Размер() == 0
        РезЗагрузки[2] = "Файл пуст или не содержит данных."
        возврат РезЗагрузки
    ;
    
    пер МассивАрт = новый Массив<Строка>()
    для Ид1 = 0 по ДанныеExcel.Размер() - 1
        МассивАрт.Добавить(ДанныеExcel[Ид1][0])
    ;
    
    пер Найденные = НайтиНоменклатуруПоАртикулам(МассивАрт)
    
    пер ТаблЗаписи = новый Массив<Массив<Строка>>()
    пер НеНайдено = новый Массив<Строка>()
    
    для Ид2 = 0 по ДанныеExcel.Размер() - 1
        пер Номенкл = Найденные[Ид2]
        
        если Номенкл == ""
            НеНайдено.Добавить("${ДанныеExcel[Ид2][0]} — ${ДанныеExcel[Ид2][1]}")
            продолжить
        ;
        
        пер НовСтр = новый Массив<Строка>()
        НовСтр.Добавить(Номенкл)
        НовСтр.Добавить(ДанныеExcel[Ид2][2])
        НовСтр.Добавить(ДанныеExcel[Ид2][3])
        ТаблЗаписи.Добавить(НовСтр)
    ;
    
    если ТаблЗаписи.Размер() > 0
        пер РезЗапись = ЗаписатьЦены(ТаблЗаписи, ТипЦены)
        пер Загружено = ТаблЗаписи.Размер()
        РезЗагрузки[2] = РезЗапись
        РезЗагрузки[1] = "$Загружено"
        РезЗагрузки[0] = "Истина"
    ;
    
    если НеНайдено.Размер() > 0
        пер ТекстОш = РезЗагрузки[2] + "\nНЕ НАЙДЕНО В БАЗЕ:\n"
        для Ид3 = 0 по НеНайдено.Размер() - 1
            ТекстОш = ТекстОш + НеНайдено[Ид3] + "\n"
        ;
        РезЗагрузки[2] = ТекстОш
    ;
    
    возврат РезЗагрузки
;

метод Скрипт()
    пер Итог = ЗагрузитьПрайс("C:\\Прайсы\\Прайс.xlsx", "Оптовая")
    Консоль.Записать("Успех: ${Итог[0]}")
    Консоль.Записать("Загружено: ${Итог[1]}")
    Консоль.Записать("Сообщение: ${Итог[2]}")
;